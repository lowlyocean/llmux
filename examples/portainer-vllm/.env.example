# Environment variables for portainer-vllm stack.
# Override defaults in docker compose command or deploy via Portainer with custom values.
LLMMUX_PORT=11434
PORT_HA=8001
PORT_IMAGES=8002
PORT_EMBED=8003

# Huggingface cache directory (mounted into all vLLM containers).
# Set to an existing path to reuse cached models:
# HFCACHE=~/.cache/huggingface
HFCACHE=~/.cache/huggingface

# Directory for CRIU checkpoint snapshots (shared volume mount).
HFCKPT=/tmp/llmux-checkpoints

# Path to llmux environment file (if needed).
ENV_FILE=.env
